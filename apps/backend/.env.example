DATABASE_URL="postgresql://binder:binder@localhost:5434/binder?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=3001
FRONTEND_URL="http://localhost:3000"

# Genera valori casuali, es: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Chat in linguaggio naturale. La chiave resta solo sul backend.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Riconoscimento delle carte nelle scansioni: servizio self-hosted apps/recognizer.
RECOGNIZER_URL="http://localhost:8000"
RECOGNIZER_TIMEOUT_MS="15000"

# Email (reset password) via SMTP: qualunque provider (Resend, Brevo, Postmark…).
# Senza SMTP_HOST, in sviluppo il link di reset finisce nei log del backend.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Binder <no-reply@example.com>"
